Libs\LibDataBroker-1.1\LibDataBroker-1.1.lua
Libs\LibDBIcon-1.0\LibDBIcon-1.0.lua

# Core — creates the AceAddon object; must load before any module
Core.lua
Core\Skin.lua
Core\Ticker.lua
Core\Migration.lua
Core\Module.lua

# Modules — each calls SP:NewModule() so they must load after Core.lua
# [AllowLoadGameType standard] = Midnight only. WoW: Forever (game type "camelot",
# Interface 16001, Vanilla content on the Midnight engine) skips those files: no specs,
# no M+, no Bloodlust, no Silvermoon, no crafting orders, no LFG tool there.
Modules\Drawer\Drawer.lua
Modules\Cursor\Cursor.lua
Modules\CopyTooltip\CopyTooltip.lua
Modules\FastLoot\FastLoot.lua
Modules\FilterExpansionOnly\FilterExpansionOnly.lua [AllowLoadGameType standard]
Modules\CVars\CVars.lua
Modules\Automation\Automation.lua
Modules\CombatTimer\CombatTimer.lua
Modules\BloodlustAlert\BloodlustAlert.lua [AllowLoadGameType standard]
Modules\PotionAlert\PotionAlert.lua [AllowLoadGameType standard]
Modules\AutoInvite\AutoInvite.lua
Modules\AutoRelease\AutoRelease.lua [AllowLoadGameType standard]
Modules\TankMD\TankMD.lua [AllowLoadGameType standard]
Modules\FocusTargetMarker\FocusTargetMarker.lua [AllowLoadGameType standard]
Modules\DeathAlert\DeathAlert.lua
Modules\CraftShopper\CraftShopper.lua
Modules\WhisperAlert\WhisperAlert.lua
