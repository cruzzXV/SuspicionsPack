# Forever only: the spellbook tab library Macro Action Bar uses (MIT, see its LICENSE).
Libs\LibSpellBookTabs-1.0\LibSpellBookTabs-1.0.lua [AllowLoadGameType camelot][ExcludeLoadGameType standard, classic]

# Core — creates the AceAddon object; must load before any module
# Perf first: it needs only the addon namespace, and Core.lua wraps its own
# file-scope handlers with it (/spack perf).
Core\Perf.lua
Core.lua
Core\Skin.lua
Core\Ticker.lua
Core\Migration.lua
Core\Module.lua

# Modules — each calls SP:NewModule() so they must load after Core.lua
# [AllowLoadGameType standard] = Midnight only. WoW: Forever (game type "camelot",
# Interface 16001, Vanilla content on the Midnight engine) skips those files: no specs,
# no M+, no Bloodlust, no Silvermoon, no crafting orders, no LFG tool there.
# MovementAlert and InterruptAlert carry no condition: they are bi-flavor. Each
# resolves by class instead of by spec when WOW_PROJECT_ID == WOW_PROJECT_CAMELOT,
# from its own FOREVER_* table of Vanilla IDs (see the top of each file).
Modules\Drawer\Drawer.lua
Modules\Cursor\Cursor.lua
Modules\CopyTooltip\CopyTooltip.lua
Modules\FastLoot\FastLoot.lua
Modules\FilterExpansionOnly\FilterExpansionOnly.lua [AllowLoadGameType standard]
Modules\CVars\CVars.lua
